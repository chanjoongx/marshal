# Copy this file to .env (gitignored) and fill in your key. Never commit the real key.
# The key may contain a '$'. Write it literally here; do not `export` it through a shell,
# where '$' segments get interpreted and mangle the key.
CRUSOE_API_KEY=your-crusoe-api-key-here

# Exact endpoint, no trailing slash. A 429 usually means this string is wrong, not throttling.
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# Model strings live in env so a swap is one line. See docs/CRUSOE_NOTES.md.
MODEL_ADVISORY=nvidia/NVIDIA-Nemotron-3-Ultra-550B
MODEL_CLASSIFY=deepseek-ai/Deepseek-V4-Flash

# MOCK=1 forces the offline MockProvider (no network). Unset or 0 for real Crusoe inference.
MOCK=1
